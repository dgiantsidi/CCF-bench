+    vec_threads.emplace_back(std::thread(run_func_append, Q));
+  }
+#endif
+  vec_threads.emplace_back(std::thread(run_func_pop, Q));
+  vec_threads[0].join();
+
+  vec_threads[1].join();
+
+  return 0;
+}
