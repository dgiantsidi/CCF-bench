+      return entry;
+    }
+
+    std::optional<std::vector<uint8_t>> get_entry_by_idx(size_t idx)
+    {
+      std::lock_guard<std::mutex> lock(ledger_access);
+      // Ledger indices are 1-based, hence the -1
